	// Хук на SetText(StringBuilder) / SetText(StringBuilder, int, int).
	private static class TMP_Text_SetTextStringBuilder_Patch
	{
		private static void Prefix(ref StringBuilder sourceText)
		{
			LogHook("TMP_SetText_sb");
			if (isPatching || !Enabled || sourceText == null || sourceText.Length == 0)
			{
				return;
			}
			isPatching = true;
			try
			{
				string original = sourceText.ToString();
				string text = Translate(original);
				if (text != original)
				{
					sourceText.Length = 0;
					sourceText.Append(text);
				}
			}
			finally
			{
				isPatching = false;
			}
		}
	}

	// Текст, сериализованный в префабе, не проходит через setter — переводим при включении объекта.
	private static class TMP_OnEnable_Patch
	{
		private static void Prefix(TMP_Text __instance)
		{
			LogHook("TMP_OnEnable");
			if (isPatching || !Enabled || (Object)(object)__instance == (Object)null)
			{
				return;
			}
			string current;
			try
			{
				current = __instance.text;
			}
			catch
			{
				return;
			}
			if (string.IsNullOrEmpty(current) || IsDialogueBoxTitle(__instance))
			{
				return;
			}
			isPatching = true;
			try
			{
				string text = Translate(current);
				if (text != current)
				{
					__instance.text = text;
					if (FontReady && ContainsKorean(text))
					{
						EnsureKoreanFallback(__instance);
					}
				}
			}
			finally
			{
				isPatching = false;
			}
		}
	}

