	/// <summary>Логирует первые 40 входов в хуки — показывает, вызываются ли они вообще.</summary>
	internal static void LogHook(string name)
	{
		if (hookLogCount >= 40)
		{
			return;
		}
		hookLogCount++;
		Log.LogInfo((object)$"[HOOK] {name} entered (n={hookLogCount}), Enabled={Enabled}, isPatching={isPatching}");
	}

