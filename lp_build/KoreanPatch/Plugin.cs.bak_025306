		GUILayout.BeginVertical(Array.Empty<GUILayoutOption>());
		GUILayout.Label("Localization Patch v3.2.3 (" + CurrentLanguage + ")", headerStyle, Array.Empty<GUILayoutOption>());
		GUILayout.Space(5f);
		GUILayout.BeginHorizontal(Array.Empty<GUILayoutOption>());
		GUILayout.Label("Patch:", labelStyle, (GUILayoutOption[])(object)new GUILayoutOption[1] { GUILayout.Width(80f) });
		if (GUILayout.Button(Enabled ? "ON" : "OFF", buttonStyle, (GUILayoutOption[])(object)new GUILayoutOption[1] { GUILayout.Width(60f) }))
		{
			Enabled = !Enabled;
		}
		GUILayout.EndHorizontal();
		GUILayout.Space(5f);
		GUILayout.Label($"Entries loaded: {Translations.Count}", labelStyle, Array.Empty<GUILayoutOption>());
		GUILayout.Label($"Applied: {translatedCount} / Missing: {missedCount}", labelStyle, Array.Empty<GUILayoutOption>());
		GUILayout.Label("Font: " + fontStatusText, labelStyle, Array.Empty<GUILayoutOption>());
		GUILayout.Label($"Patched game fonts: {totalFontsPatched}", labelStyle, Array.Empty<GUILayoutOption>());
		GUILayout.Space(10f);
		if (GUILayout.Button("Reload translations (Ctrl+F10)", buttonStyle, Array.Empty<GUILayoutOption>()))
		{
			LoadTranslations();
		}
		if (GUILayout.Button("Export untranslated strings", buttonStyle, Array.Empty<GUILayoutOption>()))
		{
			ExportUntranslated();
		}
		GUILayout.Space(5f);
		GUIStyle val = new GUIStyle(labelStyle)
		{
			fontSize = 10
		};
		val.normal.textColor = Color.gray;
		GUILayout.Label("F10 = toggle panel", val, Array.Empty<GUILayoutOption>());
		GUILayout.Label("Ctrl+F10 = reload translations", val, Array.Empty<GUILayoutOption>());
		GUILayout.Label("Ctrl+F11 = extract game data", val, Array.Empty<GUILayoutOption>());
		GUILayout.EndVertical();
		GUI.DragWindow();
	}
