	private static class FontEngine_LoadFontFace_Redirect
	{
		private static bool redirecting;

		private static bool Prefix(Font font, int pointSize, ref FontEngineError __result)
		{
			//IL_0039: Unknown result type (might be due to invalid IL or missing references)
			//IL_003f: Expected I4, but got Unknown
			if (redirecting)
			{
				return true;
			}
			if ((Object)(object)koreanProxyFont == (Object)null || (Object)(object)font != (Object)(object)koreanProxyFont || koreanFontFilePath == null)
			{
				return true;
			}
			redirecting = true;
			try
			{
				__result = (FontEngineError)(int)FontEngine.LoadFontFace(koreanFontFilePath, pointSize);
				Log.LogInfo((object)$"FontEngine redirect: LoadFontFace(proxy, {pointSize}) → LoadFontFace(file) = {__result}");
			}
			catch (Exception ex)
			{
				Log.LogWarning((object)("FontEngine redirect failed: " + ex.Message));
				return true;
			}
			finally
			{
				redirecting = false;
			}
			return false;
		}
	}

	private static class TMP_Text_SetText_Patch
	{
		private static void Prefix(TMP_Text __instance, ref string value)
		{
			LogHook("TMP_text_setter");
			if (isPatching || !Enabled || string.IsNullOrEmpty(value) || IsDialogueBoxTitle(__instance))
			{
				return;
			}
			isPatching = true;
			try
			{
				string text = Translate(value);
				if (text != value)
				{
					value = text;
					if (FontReady && ContainsKorean(text))
					{
						EnsureKoreanFallback(__instance);
					}
				}
			}
			finally
			{
				isPatching = false;
			}
		}
	}

