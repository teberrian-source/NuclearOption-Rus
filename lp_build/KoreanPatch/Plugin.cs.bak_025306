	private void Awake()
	{
		//IL_01e0: Unknown result type (might be due to invalid IL or missing references)
		//IL_01ea: Expected O, but got Unknown
		//IL_0210: Unknown result type (might be due to invalid IL or missing references)
		//IL_0215: Unknown result type (might be due to invalid IL or missing references)
		//IL_021b: Expected O, but got Unknown
		//IL_021b: Unknown result type (might be due to invalid IL or missing references)
		Log = Logger;
		Instance = this;
		languageConfig = ((BaseUnityPlugin)this).Config.Bind<string>("General", "Language", "auto", "Language code: auto (auto-detect from .json files), or specify manually (ko, de, ru, es, fr, tr, ja, zh, etc.)");
		CurrentLanguage = languageConfig.Value.ToLower().Trim();
		string directoryName = Path.GetDirectoryName(Assembly.GetExecutingAssembly().Location);
		if (CurrentLanguage == "auto")
		{
			CurrentLanguage = "ko";
			string[] array = new string[15]
			{
				"ko", "de", "ru", "es", "fr", "tr", "ja", "zh", "pt", "it",
				"pl", "nl", "ar", "th", "vi"
			};
			foreach (string text in array)
			{
				if (File.Exists(Path.Combine(directoryName, text + ".json")))
				{
					CurrentLanguage = text;
					break;
				}
			}
			if (!File.Exists(Path.Combine(directoryName, CurrentLanguage + ".json")))
			{
				array = Directory.GetFiles(directoryName, "*.json");
				for (int i = 0; i < array.Length; i++)
				{
					string fileNameWithoutExtension = Path.GetFileNameWithoutExtension(array[i]);
					if (fileNameWithoutExtension.Length >= 2 && fileNameWithoutExtension.Length <= 3 && fileNameWithoutExtension != "en_template")
					{
						CurrentLanguage = fileNameWithoutExtension;
						break;
					}
				}
			}
			Log.LogInfo((object)("Auto-detected language: " + CurrentLanguage));
		}
		translationFilePath = Path.Combine(directoryName, CurrentLanguage + ".json");
		LoadTranslations();
		HarmonyInstance = new Harmony("com.noms.localizationpatch");
		ApplyHarmonyPatches();
		if (NeedsCustomFont())
		{
			SetupKoreanFont();
			if (FontReady)
			{
				PatchAllLoadedFonts();
			}
		}
		try
		{
			GameObject val = new GameObject("LocalizationPatch_FrameHelper");
			Object.DontDestroyOnLoad((Object)val);
			((Object)val).hideFlags = (HideFlags)61;
			frameHelper = val.AddComponent<FrameHelper>();
			Log.LogInfo((object)"FrameHelper created on standalone GameObject");
		}
		catch (Exception ex)
		{
			Log.LogWarning((object)("FrameHelper creation failed: " + ex.Message + " — falling back to plugin Update()"));
		}
		SceneManager.sceneLoaded += OnSceneLoaded;
		// Первая сцена уже загружена к моменту Awake — запускаем первый скан вручную.
		lastTextScanTime = -999f;
		sceneScanUntilTime = Time.time + 10f;
		Log.LogInfo((object)$"Localization Patch v3.2.3 loaded — lang={CurrentLanguage}, {Translations.Count} translations, Font: {fontStatusText}");
	}

	private void ApplyHarmonyPatches()
	{
		//IL_0062: Unknown result type (might be due to invalid IL or missing references)
		//IL_0070: Expected O, but got Unknown
		//IL_022f: Unknown result type (might be due to invalid IL or missing references)
		//IL_023d: Expected O, but got Unknown
		//IL_0102: Unknown result type (might be due to invalid IL or missing references)
		//IL_0110: Expected O, but got Unknown
		//IL_0193: Unknown result type (might be due to invalid IL or missing references)
		//IL_01a1: Expected O, but got Unknown
		int num = 0;
		try
		{
			MethodInfo method = typeof(FontEngine).GetMethod("LoadFontFace", BindingFlags.Static | BindingFlags.Public, null, new Type[2]
			{
				typeof(Font),
				typeof(int)
			}, null);
			if (method != null)
			{
				MethodInfo method2 = typeof(FontEngine_LoadFontFace_Redirect).GetMethod("Prefix", BindingFlags.Static | BindingFlags.NonPublic);
				HarmonyInstance.Patch((MethodBase)method, new HarmonyMethod(method2), (HarmonyMethod)null, (HarmonyMethod)null, (HarmonyMethod)null, (HarmonyMethod)null);
				num++;
				Log.LogInfo((object)"Patched: FontEngine.LoadFontFace(Font, int) redirect");
			}
			else
			{
				Log.LogWarning((object)"FontEngine.LoadFontFace(Font, int) not found — redirect unavailable");
			}
		}
		catch (Exception ex)
		{
			Log.LogWarning((object)("FontEngine patch failed: " + ex.Message));
		}
		try
		{
			MethodInfo methodInfo = typeof(TMP_Text).GetProperty("text")?.GetSetMethod();
			if (methodInfo != null)
			{
				MethodInfo method3 = typeof(TMP_Text_SetText_Patch).GetMethod("Prefix", BindingFlags.Static | BindingFlags.NonPublic);
				HarmonyInstance.Patch((MethodBase)methodInfo, new HarmonyMethod(method3), (HarmonyMethod)null, (HarmonyMethod)null, (HarmonyMethod)null, (HarmonyMethod)null);
				num++;
				Log.LogInfo((object)"Patched: TMP_Text.text setter");
			}
		}
		catch (Exception ex2)
		{
			Log.LogWarning((object)("TMP_Text.text patch failed: " + ex2.Message));
		}
		try
		{
			MethodInfo methodInfo2 = typeof(Text).GetProperty("text")?.GetSetMethod();
			if (methodInfo2 != null)
			{
				MethodInfo method4 = typeof(UIText_SetText_Patch).GetMethod("Prefix", BindingFlags.Static | BindingFlags.NonPublic);
				HarmonyInstance.Patch((MethodBase)methodInfo2, new HarmonyMethod(method4), (HarmonyMethod)null, (HarmonyMethod)null, (HarmonyMethod)null, (HarmonyMethod)null);
				num++;
				Log.LogInfo((object)"Patched: Text.text setter");
			}
		}
		catch (Exception ex3)
		{
			Log.LogWarning((object)("Text.text patch failed: " + ex3.Message));
		}
		// Универсальный хук на все перегрузки TMP_Text.SetText с первым строковым параметром.
		foreach (MethodInfo item in typeof(TMP_Text).GetMethods(BindingFlags.Instance | BindingFlags.Public | BindingFlags.DeclaredOnly))
		{
			if (item.Name != "SetText" || item.IsGenericMethodDefinition)
			{
				continue;
			}
			ParameterInfo[] parameters = item.GetParameters();
			if (parameters.Length == 0 || parameters[0].ParameterType != typeof(string))
			{
				continue;
			}
			try
			{
				MethodInfo prefix2 = typeof(TMP_Text_SetTextArgs_Patch).GetMethod("Prefix", BindingFlags.Static | BindingFlags.NonPublic);
				HarmonyInstance.Patch((MethodBase)item, new HarmonyMethod(prefix2), (HarmonyMethod)null, (HarmonyMethod)null, (HarmonyMethod)null, (HarmonyMethod)null);
				num++;
				Log.LogInfo((object)$"Patched: TMP_Text.SetText({string.Join(", ", Array.ConvertAll(parameters, (ParameterInfo p) => p.ParameterType.Name))})");
			}
			catch (Exception ex5)
			{
				Log.LogWarning((object)("TMP_Text.SetText patch failed: " + ex5.Message));
			}
		}
		// SetText(StringBuilder) и SetText(StringBuilder, int, int)
		foreach (MethodInfo item2 in typeof(TMP_Text).GetMethods(BindingFlags.Instance | BindingFlags.Public))
		{
			if (item2.Name != "SetText")
			{
				continue;
			}
			ParameterInfo[] parameters2 = item2.GetParameters();
			if (parameters2.Length != 0 && parameters2[0].ParameterType == typeof(StringBuilder))
			{
				try
				{
					MethodInfo prefix3 = typeof(TMP_Text_SetTextStringBuilder_Patch).GetMethod("Prefix", BindingFlags.Static | BindingFlags.NonPublic);
					HarmonyInstance.Patch((MethodBase)item2, new HarmonyMethod(prefix3), (HarmonyMethod)null, (HarmonyMethod)null, (HarmonyMethod)null, (HarmonyMethod)null);
					num++;
					Log.LogInfo((object)"Patched: TMP_Text.SetText(StringBuilder)");
				}
				catch (Exception ex6)
				{
					Log.LogWarning((object)("TMP_Text.SetText(StringBuilder) patch failed: " + ex6.Message));
				}
			}
		}
		// OnEnable: перевод текста, сериализованного в префабе (не проходит через setter).
		foreach (Type type2 in new Type[2]
		{
			typeof(TextMeshProUGUI),
			typeof(TextMeshPro)
		})
		{
			try
			{
				MethodInfo method7 = type2.GetMethod("OnEnable", BindingFlags.Instance | BindingFlags.NonPublic | BindingFlags.DeclaredOnly);
				if (method7 != null)
				{
					MethodInfo prefix4 = typeof(TMP_OnEnable_Patch).GetMethod("Prefix", BindingFlags.Static | BindingFlags.NonPublic);
					HarmonyInstance.Patch((MethodBase)method7, new HarmonyMethod(prefix4), (HarmonyMethod)null, (HarmonyMethod)null, (HarmonyMethod)null, (HarmonyMethod)null);
					num++;
					Log.LogInfo((object)$"Patched: {type2.Name}.OnEnable (prefab text)");
				}
			}
			catch (Exception ex7)
			{
				Log.LogWarning((object)($"{type2.Name}.OnEnable patch failed: " + ex7.Message));
			}
		}
		// UI Text.OnEnable
		try
		{
			MethodInfo method8 = typeof(Text).GetMethod("OnEnable", BindingFlags.Instance | BindingFlags.NonPublic);
			if (method8 != null)
			{
				MethodInfo prefix5 = typeof(UIText_OnEnable_Patch).GetMethod("Prefix", BindingFlags.Static | BindingFlags.NonPublic);
				HarmonyInstance.Patch((MethodBase)method8, new HarmonyMethod(prefix5), (HarmonyMethod)null, (HarmonyMethod)null, (HarmonyMethod)null, (HarmonyMethod)null);
				num++;
				Log.LogInfo((object)"Patched: UI Text.OnEnable (prefab text)");
			}
		}
		catch (Exception ex8)
		{
			Log.LogWarning((object)("UI Text.OnEnable patch failed: " + ex8.Message));
		}
		// OptionData.set_text: текст элемента списка ставится напрямую, мимо AddOptions.
		foreach (Type type3 in new Type[2]
		{
			typeof(TMP_Dropdown.OptionData),
			typeof(Dropdown.OptionData)
		})
		{
			try
			{
				MethodInfo property2 = type3.GetProperty("text", BindingFlags.Instance | BindingFlags.Public)?.GetSetMethod();
				if (property2 != null)
				{
					MethodInfo prefix6 = typeof(OptionData_SetText_Patch).GetMethod("Prefix", BindingFlags.Static | BindingFlags.NonPublic);
					HarmonyInstance.Patch((MethodBase)property2, new HarmonyMethod(prefix6), (HarmonyMethod)null, (HarmonyMethod)null, (HarmonyMethod)null, (HarmonyMethod)null);
					num++;
					Log.LogInfo((object)$"Patched: {type3.FullName}.text setter");
				}
			}
			catch (Exception ex9)
			{
				Log.LogWarning((object)($"{type3.FullName} patch failed: " + ex9.Message));
			}
			try
			{
				ConstructorInfo ctor = type3.GetConstructor(BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic, null, new Type[1] { typeof(string) }, null);
				if (ctor != null)
				{
					MethodInfo prefix7 = typeof(OptionData_Ctor_Patch).GetMethod("Prefix", BindingFlags.Static | BindingFlags.NonPublic);
					HarmonyInstance.Patch((MethodBase)ctor, new HarmonyMethod(prefix7), (HarmonyMethod)null, (HarmonyMethod)null, (HarmonyMethod)null, (HarmonyMethod)null);
					num++;
					Log.LogInfo((object)$"Patched: {type3.FullName}.ctor(string)");
				}
			}
			catch (Exception ex10)
			{
				Log.LogWarning((object)($"{type3.FullName}.ctor patch failed: " + ex10.Message));
			}
		}
		Log.LogInfo((object)$"Harmony: {num} patches applied successfully");
		LogPatchedState("[DIAG-after-apply]");
	}

	/// <summary>Диагностика: реально ли висят патчи на ключевых методах (снимает ли их кто-то).</summary>
	private string DescribePatches()
	{
		try
		{
			MethodBase setText = typeof(TMP_Text).GetProperty("text")?.GetSetMethod();
			int n = setText != null ? (Harmony.GetPatchInfo(setText)?.Prefixes?.Count ?? 0) : -1;
			return $"set_text patches={n}";
		}
		catch (Exception ex)
		{
			return "diag err=" + ex.GetType().Name;
		}
	}

	private void LogPatchedState(string tag)
	{
		try
		{
			MethodBase setText = typeof(TMP_Text).GetProperty("text")?.GetSetMethod();
			MethodBase onEnable = typeof(TextMeshProUGUI).GetMethod("OnEnable", BindingFlags.Instance | BindingFlags.NonPublic | BindingFlags.DeclaredOnly);
			int n1 = setText != null ? (Harmony.GetPatchInfo(setText)?.Prefixes?.Count ?? 0) : -1;
			int n2 = onEnable != null ? (Harmony.GetPatchInfo(onEnable)?.Prefixes?.Count ?? 0) : -1;
			Log.LogInfo((object)$"{tag} set_text patches={n1}, TMPUGUI.OnEnable patches={n2}, hookLogCount={hookLogCount}");
			string probe = Translate("Settings");
			Log.LogInfo((object)$"{tag} Translate(\"Settings\") => \"{probe}\"");
		}
		catch (Exception ex)
		{
			Log.LogWarning((object)($"{tag} diag failed: {ex.GetType().Name}: {ex.Message}"));
		}
	}

	private void OnDestroy()
	{
		// Диагностика: фиксируем факт уничтожения GameObject плагина.
		Log.LogInfo((object)$"[DIAG] OnDestroy called! scene={SceneManager.GetActiveScene().name} time={Time.time:F1} — patches kept (no UnpatchSelf)");
		// ВАЖНО: UnpatchSelf ЗДЕСЬ НЕ ДЕЛАЕМ. GameObject плагина уничтожается при
		// смене сцены, а Harmony-патчи живут в IL-методах и не привязаны к объекту.
		// Раньше UnpatchSelf здесь убивал все 20 хуков при первой же загрузке сцены.
		if (loadedFontPath != null)
		{
			RemoveFontResourceEx(loadedFontPath, 16u, IntPtr.Zero);
		}
	}

	/// <summary>Страховка: перенавешивает патчи, если их кто-то снял.</summary>
	internal void EnsurePatches()
	{
		try
		{
			MethodBase setText = typeof(TMP_Text).GetProperty("text")?.GetSetMethod();
			int n = setText != null ? (Harmony.GetPatchInfo(setText)?.Prefixes?.Count ?? 0) : 0;
			if (n > 0)
			{
				return;
			}
			Log.LogInfo((object)"[DIAG] patches lost — re-applying");
			HarmonyInstance.UnpatchSelf();
			ApplyHarmonyPatches();
		}
		catch (Exception ex)
		{
			Log.LogWarning((object)("EnsurePatches failed: " + ex.Message));
		}
	}

	internal void DoPerFrameLogic()
	{
		//IL_0181: Unknown result type (might be due to invalid IL or missing references)
		//IL_0186: Unknown result type (might be due to invalid IL or missing references)
		if (Time.time - lastHeartbeatTime > 10f)
		{
			lastHeartbeatTime = Time.time;
			EnsurePatches();
			Log.LogInfo((object)$"[HB] Enabled={Enabled} isPatching={isPatching} translated={translatedCount} missed={missedCount} untranslated={untranslatedStrings.Count} scanUntil={sceneScanUntilTime:F1} now={Time.time:F1} hooks={hookLogCount} {DescribePatches()}");
		}
		if (Input.GetKeyDown((KeyCode)291) || Input.GetKeyDown((KeyCode)290))
		{
			showUI = !showUI;
			Log.LogInfo((object)$"UI toggle: {showUI}");
		}
		if (Input.GetKey((KeyCode)306) && Input.GetKeyDown((KeyCode)291))
		{
			LoadTranslations();
			translatedInstances.Clear();
			Log.LogInfo((object)$"Translations reloaded: {Translations.Count} entries");
		}
		if (Input.GetKey((KeyCode)306) && Input.GetKeyDown((KeyCode)292))
		{
			ExtractGameData();
		}
		if (Input.GetKey((KeyCode)306) && Input.GetKeyDown((KeyCode)293))
		{
			ExtractAllStrings();
		}
		// Автовыгрузка определений (описания техники/оружия, включая модовые) — 3 прохода,
		// т.к. объекты подгружаются не сразу. Файлы: extracted_gamedata.txt, extracted_strings.txt
		if (Enabled && autoDumpCount < 3 && Time.time >= nextAutoDumpTime)
		{
			autoDumpCount++;
			nextAutoDumpTime = Time.time + (float)(autoDumpCount * 60);
			try
			{
				ExtractGameData();
				ExtractAllStrings();
			}
			catch (Exception autoDumpEx)
			{
				Log.LogWarning((object)("Auto dump failed: " + autoDumpEx.Message));
			}
		}
		if (Enabled && Time.time - lastAutoExportTime > 60f)
		{
			lastAutoExportTime = Time.time;
			if (untranslatedStrings.Count > 0)
			{
				ExportUntranslated();
			}
		}
		if (FontReady && Time.time - lastFontScanTime > 10f)
		{
			lastFontScanTime = Time.time;
			PatchAllLoadedFonts();
		}
		if (Enabled && Time.time < sceneScanUntilTime && Time.time - lastTextScanTime > 1f)
		{
			lastTextScanTime = Time.time;
			Scene activeScene = SceneManager.GetActiveScene();
			int buildIndex = activeScene.buildIndex;
			if (buildIndex != lastSceneIndex)
			{
				lastSceneIndex = buildIndex;
				translatedInstances.Clear();
				Log.LogInfo((object)$"Scene changed to index {buildIndex}, resetting text scan cache");
			}
			ScanAndTranslateAllText();
		}
	}

	private void OnSceneLoaded(Scene scene, LoadSceneMode mode)
	{
		Log.LogInfo((object)$"Scene loaded: {scene.name} (index {scene.buildIndex})");
		EnsurePatches();
		translatedInstances.Clear();
		lastSceneIndex = scene.buildIndex;
		lastTextScanTime = -999f;
		sceneScanUntilTime = Time.time + 10f;
	}

	private void LoadTranslations()
	{
		Translations.Clear();
		TranslationKeys.Clear();
		if (!File.Exists(translationFilePath))
		{
			Log.LogWarning((object)("Translation file not found: " + translationFilePath));
			return;
		}
		try
		{
			string json = File.ReadAllText(translationFilePath, Encoding.UTF8);
			ParseSimpleJson(json);
			foreach (string key in Translations.Keys)
			{
				TranslationKeys.Add(key);
			}
			Log.LogInfo((object)$"Loaded {Translations.Count} translations from {CurrentLanguage}.json");
		}
		catch (Exception ex)
		{
			Log.LogError((object)("Failed to load translations: " + ex.Message));
		}
	}

	private void ParseSimpleJson(string json)
	{
		string[] array = json.Split('\n');
		List<string> list = new List<string>();
		string[] array2 = array;
		foreach (string text in array2)
		{
			if (!text.TrimStart().StartsWith("//"))
			{
				list.Add(text);
			}
		}
		json = string.Join("\n", list);
		int j;
		for (j = 0; j < json.Length && json[j] != '{'; j++)
		{
		}
		j++;
		while (j < json.Length)
		{
			for (; j < json.Length && char.IsWhiteSpace(json[j]); j++)
			{
			}
			if (j < json.Length && json[j] != '}')
			{
				string text2 = ReadJsonString(json, ref j);
				if (text2 == null)
				{
					break;
				}
				for (; j < json.Length && json[j] != ':'; j++)
				{
				}
				j++;
				string text3 = ReadJsonString(json, ref j);
				if (text3 != null)
				{
					if (!string.IsNullOrEmpty(text2) && text3 != null)
					{
						Translations[text2] = text3;
					}
					for (; j < json.Length && (char.IsWhiteSpace(json[j]) || json[j] == ','); j++)
					{
					}
					continue;
				}
				break;
			}
			break;
		}
	}

	private string ReadJsonString(string json, ref int i)
	{
		while (i < json.Length && json[i] != '"')
		{
			i++;
		}
		if (i >= json.Length)
		{
			return null;
		}
		i++;
		StringBuilder stringBuilder = new StringBuilder();
		while (i < json.Length && json[i] != '"')
		{
			if (json[i] == '\\' && i + 1 < json.Length)
			{
				i++;
				switch (json[i])
				{
				case 'n':
					stringBuilder.Append('\n');
					break;
				case 't':
					stringBuilder.Append('\t');
					break;
				case '"':
					stringBuilder.Append('"');
					break;
				case '\\':
					stringBuilder.Append('\\');
					break;
				case 'u':
					if (i + 4 < json.Length)
					{
						string value = json.Substring(i + 1, 4);
						stringBuilder.Append((char)Convert.ToInt32(value, 16));
						i += 4;
					}
					break;
				default:
					stringBuilder.Append(json[i]);
					break;
				}
			}
			else
			{
				stringBuilder.Append(json[i]);
			}
			i++;
		}
		if (i < json.Length)
		{
			i++;
		}
		return stringBuilder.ToString();
	}

	private bool NeedsCustomFont()
	{
		foreach (string value in Translations.Values)
		{
			foreach (char c in value)
			{
				if (c >= '가' && c <= '\ud7af')
				{
					return true;
				}
				if (c >= 'ㄱ' && c <= 'ㆎ')
				{
					return true;
				}
				if (c >= 'Ѐ' && c <= 'ӿ')
				{
					return true;
				}
				if (c >= '一' && c <= '\u9fff')
				{
					return true;
				}
				if (c >= '\u3040' && c <= 'ヿ')
				{
					return true;
				}
				if (c >= '\u0e00' && c <= '\u0e7f')
				{
					return true;
				}
				if (c >= '\u0600' && c <= 'ۿ')
				{
					return true;
				}
			}
		}
		Log.LogInfo((object)"Translations use Latin script only — skipping custom font setup");
		return false;
	}

	[DllImport("gdi32.dll")]
	private static extern int AddFontResourceEx(string lpszFilename, uint fl, IntPtr pdv);

	[DllImport("gdi32.dll")]
	private static extern int RemoveFontResourceEx(string lpszFilename, uint fl, IntPtr pdv);

	private string FindFontFile(string pluginDir)
	{
		string text = null;
		string[] files = Directory.GetFiles(pluginDir);
		foreach (string text2 in files)
		{
			string text3 = Path.GetExtension(text2).ToLower();
			if ((text3 == ".ttf" || text3 == ".otf") && (text == null || string.Compare(Path.GetFileName(text2), Path.GetFileName(text), StringComparison.OrdinalIgnoreCase) < 0))
			{
				text = text2;
			}
		}
		if (text != null)
		{
			Log.LogInfo((object)("Using font: " + Path.GetFileName(text)));
		}
		return text;
	}

	private void SetupKoreanFont()
	{
		//IL_0031: Unknown result type (might be due to invalid IL or missing references)
		//IL_0036: Unknown result type (might be due to invalid IL or missing references)
		//IL_0041: Unknown result type (might be due to invalid IL or missing references)
		//IL_0094: Unknown result type (might be due to invalid IL or missing references)
		//IL_0099: Unknown result type (might be due to invalid IL or missing references)
		//IL_00a5: Unknown result type (might be due to invalid IL or missing references)
		//IL_00b6: Unknown result type (might be due to invalid IL or missing references)
		//IL_01f3: Unknown result type (might be due to invalid IL or missing references)
		//IL_01f8: Unknown result type (might be due to invalid IL or missing references)
		//IL_0204: Unknown result type (might be due to invalid IL or missing references)
		//IL_0215: Unknown result type (might be due to invalid IL or missing references)
		//IL_00bd: Unknown result type (might be due to invalid IL or missing references)
		//IL_00c2: Unknown result type (might be due to invalid IL or missing references)
		//IL_0219: Unknown result type (might be due to invalid IL or missing references)
		//IL_021e: Unknown result type (might be due to invalid IL or missing references)
		//IL_0193: Unknown result type (might be due to invalid IL or missing references)
		//IL_019e: Unknown result type (might be due to invalid IL or missing references)
		try
		{
			string directoryName = Path.GetDirectoryName(Assembly.GetExecutingAssembly().Location);
			string text = FindFontFile(directoryName);
			Log.LogInfo((object)("Unity version: " + Application.unityVersion));
			FontEngineError val = FontEngine.InitializeFontEngine();
			Log.LogInfo((object)$"FontEngine.InitializeFontEngine: {val}");
			if (text != null && File.Exists(text))
			{
				int num = AddFontResourceEx(text, 16u, IntPtr.Zero);
				Log.LogInfo((object)$"AddFontResourceEx: result={num}");
				loadedFontPath = text;
				FontEngineError val2 = FontEngine.LoadFontFace(text, 36);
				Log.LogInfo((object)$"FontEngine.LoadFontFace(filePath): {val2}");
				if ((int)val2 == 0)
				{
					FaceInfo faceInfo = FontEngine.GetFaceInfo();
					Log.LogInfo((object)$"Font face loaded: {faceInfo.familyName} {faceInfo.styleName}, {faceInfo.pointSize}pt");
					koreanFontFilePath = text;
					string familyName = faceInfo.familyName;
					koreanProxyFont = Font.CreateDynamicFontFromOSFont(familyName, 36);
					if ((Object)(object)koreanProxyFont == (Object)null)
					{
						Log.LogWarning((object)("CreateDynamicFontFromOSFont(\"" + familyName + "\") failed, falling back to Arial proxy"));
						koreanProxyFont = Font.CreateDynamicFontFromOSFont("Arial", 24);
					}
					else
					{
						Log.LogInfo((object)("Created OS font from registered name: " + familyName));
					}
					KoreanFontAsset = TMP_FontAsset.CreateFontAsset(koreanProxyFont, 36, 4, (GlyphRenderMode)4165, 4096, 4096, (AtlasPopulationMode)1, true);
					if ((Object)(object)KoreanFontAsset != (Object)null)
					{
						FontEngine.LoadFontFace(text, 36);
						KoreanFontAsset.faceInfo = FontEngine.GetFaceInfo();
						Log.LogInfo((object)"CreateFontAsset succeeded with registered font!");
					}
					else
					{
						Log.LogWarning((object)"CreateFontAsset returned null, trying manual creation...");
						KoreanFontAsset = TryManualFontCreation(text);
					}
				}
				else
				{
					Log.LogWarning((object)"File path loading failed, trying byte array...");
					FontEngineError val3 = FontEngine.LoadFontFace(File.ReadAllBytes(text), 36);
					Log.LogInfo((object)$"FontEngine.LoadFontFace(bytes): {val3}");
					if ((int)val3 == 0)
					{
						FaceInfo faceInfo2 = FontEngine.GetFaceInfo();
						koreanFontFilePath = text;
						koreanProxyFont = Font.CreateDynamicFontFromOSFont(faceInfo2.familyName, 36) ?? Font.CreateDynamicFontFromOSFont("Arial", 24);
						KoreanFontAsset = TryManualFontCreation(text);
					}
				}
			}
			else
			{
				Log.LogError((object)("No font file found in plugin folder. Place font.ttf/font.otf or Pretendard-Regular.otf in: " + directoryName));
			}
			if ((Object)(object)KoreanFontAsset == (Object)null)
			{
				Log.LogInfo((object)"Searching for existing Korean-capable font in game...");
				KoreanFontAsset = FindExistingKoreanFont();
			}
			if ((Object)(object)KoreanFontAsset != (Object)null)
			{
				string fileNameWithoutExtension = Path.GetFileNameWithoutExtension(text);
				((Object)KoreanFontAsset).name = "LocalizationPatch_" + fileNameWithoutExtension;
				KoreanFontAsset.atlasPopulationMode = (AtlasPopulationMode)1;
				Object.DontDestroyOnLoad((Object)(object)KoreanFontAsset);
				PrePopulateFromTranslations();
				AddToGlobalFallback();
				FontReady = true;
				fontStatusText = "Ready (" + fileNameWithoutExtension + ")";
				ManualLogSource log = Log;
				Texture2D atlasTexture = KoreanFontAsset.atlasTexture;
				object arg = ((atlasTexture != null) ? new int?(((Texture)atlasTexture).width) : null);
				Texture2D atlasTexture2 = KoreanFontAsset.atlasTexture;
				log.LogInfo((object)$"Custom TMP font ready ({fileNameWithoutExtension})! Atlas: {arg}x{((atlasTexture2 != null) ? new int?(((Texture)atlasTexture2).height) : null)}");
			}
			else
			{
				Log.LogError((object)"All font creation methods failed!");
				fontStatusText = "Font creation failed";
				LogDiagnostics();
			}
		}
		catch (Exception ex)
		{
			Log.LogError((object)$"Font setup error: {ex}");
			fontStatusText = "Error: " + ex.Message;
		}
	}

	private TMP_FontAsset TryManualFontCreation(string fontPath)
	{
		//IL_0000: Unknown result type (might be due to invalid IL or missing references)
		//IL_0009: Unknown result type (might be due to invalid IL or missing references)
		//IL_000e: Unknown result type (might be due to invalid IL or missing references)
		//IL_000f: Unknown result type (might be due to invalid IL or missing references)
		//IL_0034: Unknown result type (might be due to invalid IL or missing references)
		//IL_0039: Unknown result type (might be due to invalid IL or missing references)
		//IL_0068: Unknown result type (might be due to invalid IL or missing references)
		//IL_00e1: Unknown result type (might be due to invalid IL or missing references)
		//IL_00e7: Expected O, but got Unknown
		//IL_001c: Unknown result type (might be due to invalid IL or missing references)
		//IL_0142: Unknown result type (might be due to invalid IL or missing references)
		//IL_0149: Expected O, but got Unknown
		//IL_01d6: Unknown result type (might be due to invalid IL or missing references)
		try
		{
			FontEngine.InitializeFontEngine();
			FontEngineError val = FontEngine.LoadFontFace(fontPath, 36);
			if ((int)val != 0)
			{
				Log.LogWarning((object)$"Manual creation: FontEngine.LoadFontFace failed: {val}");
				return null;
			}
			FaceInfo faceInfo = FontEngine.GetFaceInfo();
			Log.LogInfo((object)$"Manual creation: face={faceInfo.familyName}, pointSize={faceInfo.pointSize}");
			TMP_FontAsset val2 = ScriptableObject.CreateInstance<TMP_FontAsset>();
			val2.faceInfo = faceInfo;
			SetFieldValue(val2, "m_SourceFontFile", koreanProxyFont);
			SetFieldValue(val2, "m_AtlasWidth", 4096);
			SetFieldValue(val2, "m_AtlasHeight", 4096);
			SetFieldValue(val2, "m_AtlasPadding", 4);
			SetFieldValue(val2, "m_AtlasRenderMode", (object)(GlyphRenderMode)4165);
			val2.atlasPopulationMode = (AtlasPopulationMode)1;
			Texture2D val3 = new Texture2D(4096, 4096, (TextureFormat)1, false);
			((Object)val3).name = "KoreanPatch_Atlas";
			val2.atlasTextures = (Texture2D[])(object)new Texture2D[1] { val3 };
			Shader val4 = FindGameSdfShader();
			if ((Object)(object)val4 == (Object)null)
			{
				val4 = Shader.Find("TextMeshPro/Distance Field");
				if ((Object)(object)val4 == (Object)null)
				{
					val4 = Shader.Find("TextMeshPro/Mobile/Distance Field");
				}
			}
			if ((Object)(object)val4 != (Object)null)
			{
				Material val5 = new Material(val4);
				((Object)val5).name = "KoreanPatch_Material";
				val5.SetTexture(ShaderUtilities.ID_MainTex, (Texture)(object)val3);
				((TMP_Asset)val2).material = val5;
				Log.LogInfo((object)("Manual creation: shader=" + ((Object)val4).name));
				SetFieldValue(val2, "m_GlyphTable", new List<Glyph>());
				SetFieldValue(val2, "m_CharacterTable", new List<TMP_Character>());
				SetFieldValue(val2, "m_FreeGlyphRects", new List<GlyphRect>
				{
					new GlyphRect(0, 0, 4092, 4092)
				});
				SetFieldValue(val2, "m_UsedGlyphRects", new List<GlyphRect>());
				SetFieldValue(val2, "m_AtlasTextureIndex", 0);
				try
				{
					typeof(TMP_FontAsset).GetMethod("ReadFontAssetDefinition", BindingFlags.Instance | BindingFlags.Public)?.Invoke(val2, null);
					Log.LogInfo((object)"Manual creation: ReadFontAssetDefinition called");
				}
				catch (Exception ex)
				{
					Log.LogWarning((object)("ReadFontAssetDefinition failed: " + ex.Message));
				}
				Log.LogInfo((object)"Manual TMP_FontAsset created successfully");
				return val2;
			}
			Log.LogWarning((object)"Manual creation: no SDF shader found!");
			return null;
		}
		catch (Exception arg)
		{
			Log.LogError((object)$"Manual font creation failed: {arg}");
			return null;
		}
	}

	private TMP_FontAsset FindExistingKoreanFont()
	{
		//IL_012f: Unknown result type (might be due to invalid IL or missing references)
		//IL_0135: Invalid comparison between Unknown and I4
		try
		{
			TMP_FontAsset[] array = Resources.FindObjectsOfTypeAll<TMP_FontAsset>();
			Log.LogInfo((object)$"Scanning {array.Length} TMP fonts for Korean support...");
			TMP_FontAsset[] array2 = array;
			foreach (TMP_FontAsset val in array2)
			{
				if ((Object)(object)val == (Object)null)
				{
					continue;
				}
				if (val.HasCharacter('가', false, false))
				{
					Log.LogInfo((object)("  Found Korean-capable font: " + ((Object)val).name));
					return val;
				}
				if (val.fallbackFontAssetTable == null)
				{
					continue;
				}
				foreach (TMP_FontAsset item in val.fallbackFontAssetTable)
				{
					if ((Object)(object)item != (Object)null && item.HasCharacter('가', false, false))
					{
						Log.LogInfo((object)("  Found Korean-capable fallback font: " + ((Object)item).name + " (from " + ((Object)val).name + ")"));
						return item;
					}
				}
			}
			array2 = array;
			foreach (TMP_FontAsset val2 in array2)
			{
				if ((Object)(object)val2 == (Object)null || (int)val2.atlasPopulationMode != 1)
				{
					continue;
				}
				try
				{
					if (val2.TryAddCharacters("가", false))
					{
						Log.LogInfo((object)("  Font '" + ((Object)val2).name + "' can dynamically add Korean!"));
						return val2;
					}
				}
				catch
				{
				}
			}
			Log.LogWarning((object)"No existing Korean-capable font found in game");
		}
		catch (Exception ex)
		{
			Log.LogWarning((object)("Korean font search failed: " + ex.Message));
		}
		return null;
	}

	private Shader FindGameSdfShader()
	{
		TMP_FontAsset[] array = Resources.FindObjectsOfTypeAll<TMP_FontAsset>();
		foreach (TMP_FontAsset val in array)
		{
			object obj;
			if (val == null)
			{
				obj = null;
			}
			else
			{
				Material material = ((TMP_Asset)val).material;
				obj = ((material != null) ? material.shader : null);
			}
			if ((Object)obj != (Object)null)
			{
				return ((TMP_Asset)val).material.shader;
			}
		}
		return null;
	}

	private void PrePopulateFromTranslations()
	{
		if ((Object)(object)KoreanFontAsset == (Object)null)
		{
			return;
		}
		try
		{
			HashSet<char> hashSet = new HashSet<char>();
			foreach (string value in Translations.Values)
			{
				foreach (char c in value)
				{
					if (c >= '가' && c <= '\ud7af')
					{
						hashSet.Add(c);
					}
					else if (c >= 'ㄱ' && c <= 'ㆎ')
					{
						hashSet.Add(c);
					}
					else if (c >= 'Ѐ' && c <= 'ӿ')
					{
						hashSet.Add(c);
					}
					else if (c >= '一' && c <= '\u9fff')
					{
						hashSet.Add(c);
					}
					else if (c >= '\u3040' && c <= 'ヿ')
					{
						hashSet.Add(c);
					}
					else if (c >= '\u0e00' && c <= '\u0e7f')
					{
						hashSet.Add(c);
					}
					else if (c >= '\u0600' && c <= 'ۿ')
					{
						hashSet.Add(c);
					}
				}
			}
			if (hashSet.Count != 0)
			{
				string text = new string(new List<char>(hashSet).ToArray());
				Log.LogInfo((object)$"Pre-populating {text.Length} unique Korean chars from translations...");
				string text2 = default(string);
				if (KoreanFontAsset.TryAddCharacters(text, out text2, false))
				{
					Log.LogInfo((object)$"Pre-populated ALL {text.Length} Korean glyphs successfully!");
					return;
				}
				int num = text.Length - (text2?.Length ?? 0);
				Log.LogInfo((object)$"Pre-populated {num}/{text.Length} glyphs ({text2?.Length ?? 0} missing)");
			}
		}
		catch (Exception ex)
		{
			Log.LogWarning((object)("Glyph pre-population failed: " + ex.Message));
		}
	}

	private void AddToGlobalFallback()
	{
		try
		{
			PropertyInfo property = typeof(TMP_Settings).GetProperty("fallbackFontAssets", BindingFlags.Static | BindingFlags.Public);
			if (property != null && property.GetValue(null) is List<TMP_FontAsset> list && !list.Contains(KoreanFontAsset))
			{
				list.Add(KoreanFontAsset);
				Log.LogInfo((object)"Added Korean font to TMP global fallback list");
			}
		}
		catch (Exception ex)
		{
			Log.LogWarning((object)("Could not set global fallback: " + ex.Message));
		}
	}

	internal static void PatchAllLoadedFonts()
	{
		if (!FontReady || (Object)(object)KoreanFontAsset == (Object)null)
		{
			return;
		}
		try
		{
			TMP_FontAsset[] array = Resources.FindObjectsOfTypeAll<TMP_FontAsset>();
			int num = 0;
			TMP_FontAsset[] array2 = array;
			foreach (TMP_FontAsset val in array2)
			{
				if ((Object)(object)val == (Object)null || (Object)(object)val == (Object)(object)KoreanFontAsset)
				{
					continue;
				}
				int instanceID = ((Object)val).GetInstanceID();
				if (patchedFonts.Contains(instanceID))
				{
					continue;
				}
				try
				{
					List<TMP_FontAsset> list = val.fallbackFontAssetTable;
					if (list == null)
					{
						list = (val.fallbackFontAssetTable = new List<TMP_FontAsset>());
					}
					if (!list.Contains(KoreanFontAsset))
					{
						list.Add(KoreanFontAsset);
						num++;
					}
					patchedFonts.Add(instanceID);
				}
				catch
				{
				}
			}
			if (num > 0)
			{
				Instance.totalFontsPatched += num;
				Log.LogInfo((object)$"Patched {num} new TMP fonts with Korean fallback (total: {Instance.totalFontsPatched})");
			}
		}
		catch (Exception ex)
		{
			Log.LogWarning((object)("Font scan error: " + ex.Message));
		}
	}

	internal static void EnsureKoreanFallback(TMP_Text textComponent)
	{
		if (!FontReady || (Object)(object)KoreanFontAsset == (Object)null || (Object)(object)textComponent == (Object)null || (Object)(object)textComponent.font == (Object)null)
		{
			return;
		}
		int instanceID = ((Object)textComponent.font).GetInstanceID();
		if (patchedFonts.Contains(instanceID))
		{
			return;
		}
		try
		{
			List<TMP_FontAsset> list = textComponent.font.fallbackFontAssetTable;
			if (list == null)
			{
				list = new List<TMP_FontAsset>();
				textComponent.font.fallbackFontAssetTable = list;
			}
			if (!list.Contains(KoreanFontAsset))
			{
				list.Add(KoreanFontAsset);
				patchedFonts.Add(instanceID);
			}
			else
			{
				patchedFonts.Add(instanceID);
			}
		}
		catch
		{
		}
	}

	private void LogDiagnostics()
	{
		//IL_00bc: Unknown result type (might be due to invalid IL or missing references)
		try
		{
			TMP_FontAsset[] array = Resources.FindObjectsOfTypeAll<TMP_FontAsset>();
			Log.LogInfo((object)"=== Diagnostics ===");
			Log.LogInfo((object)$"TMP fonts in game: {array.Length}");
			TMP_FontAsset[] array2 = array;
			foreach (TMP_FontAsset val in array2)
			{
				if ((Object)(object)val != (Object)null)
				{
					ManualLogSource log = Log;
					object[] obj = new object[5]
					{
						((Object)val).name,
						null,
						null,
						null,
						null
					};
					Texture2D atlasTexture = val.atlasTexture;
					obj[1] = ((atlasTexture != null) ? new int?(((Texture)atlasTexture).width) : null);
					Texture2D atlasTexture2 = val.atlasTexture;
					obj[2] = ((atlasTexture2 != null) ? new int?(((Texture)atlasTexture2).height) : null);
					obj[3] = val.atlasPopulationMode;
					obj[4] = val.characterTable?.Count ?? 0;
					log.LogInfo((object)string.Format("  - {0} (atlas: {1}x{2}, mode: {3}, chars: {4})", obj));
				}
			}
			string[] oSInstalledFontNames = Font.GetOSInstalledFontNames();
			Log.LogInfo((object)$"OS fonts: {oSInstalledFontNames.Length}");
			string[] array3 = oSInstalledFontNames;
			foreach (string text in array3)
			{
				string text2 = text.ToLower();
				if (text2.Contains("malgun") || text2.Contains("gothic") || text2.Contains("nanum") || text2.Contains("gulim") || text2.Contains("batang") || text2.Contains("pretendard"))
				{
					Log.LogInfo((object)("  Korean font: " + text));
				}
			}
		}
		catch
		{
		}
	}

	private static void SetFieldValue(object obj, string fieldName, object value)
	{
		FieldInfo field = obj.GetType().GetField(fieldName, BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
		if (field != null)
		{
			field.SetValue(obj, value);
		}
		else
		{
			Log.LogWarning((object)("Field '" + fieldName + "' not found on " + obj.GetType().Name));
		}
	}

	private void ScanAndTranslateAllText()
	{
		if (isPatching)
		{
			return;
		}
		isPatching = true;
		try
		{
			TMP_Text[] array = Resources.FindObjectsOfTypeAll<TMP_Text>();
			foreach (TMP_Text val in array)
			{
				if ((Object)(object)val == (Object)null || (Object)(object)((Component)val).gameObject == (Object)null)
				{
					continue;
				}
				int instanceID = ((Object)val).GetInstanceID();
				string text = val.text;
				if (string.IsNullOrEmpty(text))
				{
					continue;
				}
				string text2 = text.Trim();
				if (translatedInstances.Contains(instanceID))
				{
					if (!TranslationKeys.Contains(text2) && TryPatternMatch(text2) == null)
					{
						continue;
					}
					translatedInstances.Remove(instanceID);
				}
				if (IsDialogueBoxTitle(val))
				{
					continue;
				}
				string text3 = null;
				text3 = ((!TranslationKeys.Contains(text2)) ? TryPatternMatch(text2) : Translations[text2]);
				if (text3 != null)
				{
					val.text = text3;
					translatedInstances.Add(instanceID);
					if (FontReady && ContainsKorean(text3))
					{
						EnsureKoreanFallback(val);
					}
				}
			}
			Text[] array2 = Resources.FindObjectsOfTypeAll<Text>();
			foreach (Text val2 in array2)
			{
				if ((Object)(object)val2 == (Object)null || (Object)(object)((Component)val2).gameObject == (Object)null)
				{
					continue;
				}
				int instanceID2 = ((Object)val2).GetInstanceID();
				string text4 = val2.text;
				if (string.IsNullOrEmpty(text4))
				{
					continue;
				}
				string text5 = text4.Trim();
				if (translatedInstances.Contains(instanceID2))
				{
					if (!TranslationKeys.Contains(text5) && TryPatternMatch(text5) == null)
					{
						continue;
					}
					translatedInstances.Remove(instanceID2);
				}
				string text6 = null;
				text6 = ((!TranslationKeys.Contains(text5)) ? TryPatternMatch(text5) : Translations[text5]);
				if (text6 != null)
				{
					val2.text = text6;
					translatedInstances.Add(instanceID2);
				}
			}
		}
		catch (Exception ex)
		{
			Log.LogWarning((object)("Text scan error: " + ex.Message));
		}
		finally
		{
			isPatching = false;
		}
	}

	internal static string Translate(string original)
	{
		if (!Enabled || string.IsNullOrEmpty(original))
		{
			return original;
		}
		string text = original.Trim();
		if (TranslationKeys.Contains(text))
		{
			Instance.translatedCount++;
			if (traceLoggedHits.Count < 1500 && traceLoggedHits.Add(text))
			{
				Log.LogInfo((object)$"[TRACE] hit: \"{text.Substring(0, Math.Min(180, text.Length))}\"");
			}
			return Translations[text];
		}
		string text2 = TryPatternMatch(text);
		if (text2 != null)
		{
			Instance.translatedCount++;
			return text2;
		}
		if (text.IndexOf("color=", StringComparison.Ordinal) >= 0)
		{
			string text3 = TryKillFeed(text);
			if (text3 != null)
			{
				Instance.translatedCount++;
				return text3;
			}
		}
		if (text.IndexOf('\n') >= 0)
		{
			string text4 = TryAssembleSegments(text);
			if (text4 != null)
			{
				Instance.translatedCount++;
				return text4;
			}
		}
		if (text.Length > 1 && text.Length < 3000 && !IsNumericOrSymbol(text) && !IsJunkForTranslation(text))
		{
			Instance.missedCount++;
			if (Instance.untranslatedStrings.Count < 100000)
			{
				Instance.untranslatedStrings.Add(text);
			}
			if (traceLoggedMisses.Count < 2000 && traceLoggedMisses.Add(text))
			{
				Log.LogInfo((object)$"[TRACE] miss: \"{text.Substring(0, Math.Min(200, text.Length))}\"");
			}
		}
		return original;
	}

	private static string TryPatternMatch(string text)
	{
		int num = text.LastIndexOf(" (");
		if (num > 0 && text.EndsWith(")"))
		{
			string text2 = text.Substring(0, num);
			string text3 = text.Substring(num);
			if (TranslationKeys.Contains(text2))
			{
				return Translations[text2] + text3;
			}
		}
		if (text.Length > 3)
		{
			int num2 = text.IndexOf(". ");
			if (num2 >= 1 && num2 <= 3)
			{
				string text4 = text.Substring(0, num2 + 2);
				string text5 = text.Substring(num2 + 2);
				if (TranslationKeys.Contains(text5))
				{
					return text4 + Translations[text5];
				}
			}
		}
		int num3 = text.IndexOf(" - ");
		if (num3 > 0)
		{
			string text6 = text.Substring(0, num3);
			string text7 = text.Substring(num3 + 3);
			if (TranslationKeys.Contains(text6))
			{
				string text8 = Translations[text6];
				if (TranslationKeys.Contains(text7))
				{
					return text8 + " - " + Translations[text7];
				}
				return text8 + " - " + text7;
			}
		}
		if (text.StartsWith("Tutorial ") && text.Contains(" - "))
		{
			int num4 = text.IndexOf(" - ");
			string text9 = text.Substring(num4 + 3);
			string text10 = text.Substring(9, num4 - 9);
			string text11 = (TranslationKeys.Contains("Tutorial") ? Translations["Tutorial"] : "Tutorial");
			if (TranslationKeys.Contains(text9))
			{
				return text11 + " " + text10 + " - " + Translations[text9];
			}
			return text11 + " " + text10 + " - " + text9;
		}
		if (text.StartsWith("PALA ") || text.StartsWith("BDF "))
		{
			string text12 = (text.StartsWith("PALA ") ? "PALA " : "BDF ");
			string text13 = text.Substring(text12.Length);
			int num5 = text13.LastIndexOf(" ($");
			if (num5 > 0 && text13.EndsWith(")"))
			{
				string text14 = text13.Substring(0, num5);
				string text15 = text13.Substring(num5);
				if (TranslationKeys.Contains(text14))
				{
					return text12 + Translations[text14] + text15;
				}
			}
			if (TranslationKeys.Contains(text13))
			{
				return text12 + Translations[text13];
			}
		}
		if (text.StartsWith("Buy "))
		{
			return (TranslationKeys.Contains("Buy") ? Translations["Buy"] : "Buy") + " " + text.Substring(4);
		}
		int num6 = text.IndexOf(": ");
		if (num6 > 0 && num6 < text.Length - 2)
		{
			string text16 = text.Substring(0, num6 + 1);
			string text17 = text.Substring(num6 + 1);
			if (TranslationKeys.Contains(text16))
			{
				return Translations[text16] + text17;
			}
		}
		Match match = EndGameKickRe.Match(text);
		if (match.Success)
		{
			return "Вы уверены, что хотите завершить игру? Это исключит из игры " + match.Groups[1].Value + " " + PluralPlayers(match.Groups[1].Value) + ".";
		}
		return TryLabelWithValue(text);
	}

	private static string PluralPlayers(string count)
	{
		int num;
		if (!int.TryParse(count, out num))
		{
			return "игроков";
		}
		if (num % 10 == 1 && num % 100 != 11)
		{
			return "игрока";
		}
		return "игроков";
	}

	private static string TryLabelWithValue(string text)
	{
		Match match = LabelValueRe.Match(text);
		if (!match.Success)
		{
			return null;
		}
		string text2 = match.Groups["label"].Value;
		string text3 = match.Groups["value"].Value;
		if (LabelWithValueKeys.Contains(text2))
		{
			if (TranslationKeys.Contains(text2))
			{
				return Translations[text2] + " " + text3;
			}
			return null;
		}
		Match match2 = BaseNumberRe.Match(text2);
		if (match2.Success)
		{
			string text4 = match2.Groups["base"].Value;
			if (LabelWithValueKeys.Contains(text4) && TranslationKeys.Contains(text4))
			{
				return Translations[text4] + " " + match2.Groups["num"].Value + " " + text3;
			}
		}
		return null;
	}

	private static readonly HashSet<string> LabelWithValueKeys = new HashSet<string>
	{
		"Return To Base", "Search For Convoy", "Break Blockade", "Defend Island",
		"Destroy Vehicles", "Detected units", "Repaired unit", "Take Off", "Taxi",
		"Taxi to Runway", "Cleared for landing on Runway", "Cleared to taxi to Runway",
		"Successful Sortie +"
	};

	private static readonly Regex LabelValueRe = new Regex(
		"^(?<label>.+?)\\s(?<value>[+\\-]?\\d[\\d.,]*(?:\\s?(?:km|m|nm|kt|ft|s|min))?)$",
		RegexOptions.Compiled);

	private static readonly Regex BaseNumberRe = new Regex(
		"^(?<base>.+)\\s(?<num>\\d{1,3})$",
		RegexOptions.Compiled);

	private static readonly Regex EndGameKickRe = new Regex(
		"^Are you sure you want to end the game\\? Doing so will kick (\\d+) other players?\\.$",
		RegexOptions.Compiled);

	private static readonly Dictionary<string, string> FeedVerbs = new Dictionary<string, string>
	{
		{ "intercepted", "перехватил" },
		{ "destroyed", "уничтожил" },
		{ "shot down", "сбил" },
		{ "demolished", "разрушил" },
		{ "sank", "потопил" },
		{ "was rescued by", "был спасён" },
		{ "was captured by", "был захвачен" },
		{ "was destroyed", "был уничтожен" },
		{ "collapsed", "обрушился" }
	};

	private static readonly Regex FeedPairRe = new Regex(
		"^(<color=[^>]*>[^<]*</color>)\\s*(intercepted|destroyed|shot down|demolished|sank|was rescued by|was captured by)\\s*(<color=[^>]*>[^<]*</color>)(\\s*<color=[^>]*>\\([^<]*\\)</color>)?$",
		RegexOptions.Compiled);

	private static readonly Regex FeedSingleRe = new Regex(
		"^(<color=[^>]*>[^<]*</color>)\\s*(was destroyed|collapsed)$",
		RegexOptions.Compiled);

	private static readonly Regex FeedJoinedRe = new Regex(
		"^(<color=[^>]*>)([^<]*joined the game)(</color>)$",
		RegexOptions.Compiled);

	/// <summary>Переводит kill-feed: заменяет глагол между color-обёрнутыми названиями юнитов. Если строка не является kill-feed — null.</summary>
	private static string TryKillFeed(string text)
	{
		if (text.IndexOf("color=", StringComparison.Ordinal) < 0)
		{
			return null;
		}
		string[] lines = text.Split('\n');
		StringBuilder sb = new StringBuilder(text.Length + 16);
		bool any = false;
		for (int i = 0; i < lines.Length; i++)
		{
			string line = lines[i].Trim();
			if (i > 0)
			{
				sb.Append('\n');
			}
			Match m = FeedPairRe.Match(line);
			if (m.Success)
			{
				string verb;
				if (FeedVerbs.TryGetValue(m.Groups[2].Value, out verb))
				{
					sb.Append(m.Groups[1].Value).Append(' ').Append(verb).Append(' ').Append(m.Groups[3].Value);
					if (m.Groups[4].Success)
					{
						sb.Append(m.Groups[4].Value);
					}
					any = true;
					continue;
				}
			}
			m = FeedSingleRe.Match(line);
			if (m.Success)
			{
				string verb;
				if (FeedVerbs.TryGetValue(m.Groups[2].Value, out verb))
				{
					sb.Append(m.Groups[1].Value).Append(' ').Append(verb);
					any = true;
					continue;
				}
			}
			m = FeedJoinedRe.Match(line);
			if (m.Success)
			{
				sb.Append(m.Groups[1].Value).Append(m.Groups[2].Value.Replace("joined the game", "зашёл в игру")).Append(m.Groups[3].Value);
				any = true;
				continue;
			}
			return null;
		}
		return any ? sb.ToString() : null;
	}

	/// <summary>Собирает многострочную строку посегментно: каждый сегмент переводится словарём или паттерном, незнакомые сегменты остаются как есть.</summary>
	private static string TryAssembleSegments(string text)
	{
		string[] segs = text.Split('\n');
		StringBuilder sb = new StringBuilder(text.Length + 16);
		bool any = false;
		for (int i = 0; i < segs.Length; i++)
		{
			if (i > 0)
			{
				sb.Append('\n');
			}
			string seg = segs[i].Trim();
			string r = null;
			if (seg.Length > 0 && TranslationKeys.Contains(seg))
			{
				r = Translations[seg];
			}
			else if (seg.Length > 0)
			{
				r = TryPatternMatch(seg);
			}
			if (r != null)
			{
				sb.Append(r);
				any = true;
			}
			else
			{
				sb.Append(segs[i]);
			}
		}
		return any ? sb.ToString() : null;
	}

	private static bool IsNumericOrSymbol(string s)
	{
		for (int i = 0; i < s.Length; i++)
		{
			if (char.IsLetter(s[i]))
			{
				return false;
			}
		}
		return true;
	}

	/// <summary>
	/// Строки-«мусор», которые не переводятся и не должны попадать в untranslated.txt:
	/// деньги, дистанции, массы, таймеры, координаты сетки, единицы измерения.
	/// </summary>
	private static bool IsJunkForTranslation(string s)
	{
		foreach (Regex regex in JunkPatterns)
		{
			if (regex.IsMatch(s))
			{
				return true;
			}
		}
		return false;
	}

	private static readonly Regex[] JunkPatterns = new Regex[19]
	{
		new Regex("^\\s*[\\d.,]+\\s*(kg|km|km/h|kt|t|s|ms|%|h|g|G|k|m|b|m/s|kW/kg|kN|MW|m2|ft|nm)?\\s*$", RegexOptions.Compiled),
		new Regex("^\\s*[\\d.,]+\\s*t?\\s*/\\s*[\\d.,]+\\s*t?\\s*$", RegexOptions.Compiled),
		new Regex("^\\s*[$€£][\\d.,]+\\s*[kmb]?\\s*$", RegexOptions.Compiled),
		new Regex("^\\s*[$€£]?[\\d.,]+\\s*[mMbB]\\s*\\(\\s*\\+[\\d.,]+\\s*[mMbB]\\s*\\)\\s*$", RegexOptions.Compiled),
		new Regex("^\\s*[A-Z]{0,4}\\s*:?\\s*[$€£][\\d.,]+\\s*[kmb]?\\s*$", RegexOptions.Compiled),
		new Regex("^\\s*[\\d.,]+\\s*[mMbB]?\\s*\\$\\s*$", RegexOptions.Compiled),
		new Regex("^\\s*\\S{1,4}\\s*:\\s*[\\d.,]+\\s*[\\w%]{0,6}\\s*$", RegexOptions.Compiled),
		new Regex("^\\s*%?\\s*\\p{L}{1,6}\\s*:?\\s*[\\d.,]+\\s*%?\\s*$", RegexOptions.Compiled),
		new Regex("^\\s*\\d+\\s+[A-Z]{2,4}\\s*$", RegexOptions.Compiled),
		new Regex("^\\s*x\\s+\\d+\\s*$", RegexOptions.Compiled),
		new Regex("^\\s*[A-Z][a-z]\\d{2,3}\\s*$", RegexOptions.Compiled),
		new Regex("^\\s*Time\\b.*\\d.*Duration\\b.*$", RegexOptions.Compiled),
		new Regex("^\\s*Score\\b.*\\d.*$", RegexOptions.Compiled),
		new Regex("^\\s*Pass\\s*:\\s*\\d+\\s*$", RegexOptions.Compiled),
		new Regex("^\\s*RANK\\s+\\d+.*$", RegexOptions.Compiled),
		new Regex("^\\s*[\\d.,]+\\s*\\p{L}{1,4}/\\p{L}{1,4}\\s*$", RegexOptions.Compiled),
		new Regex("^\\s*\\(?(kb|ms|us|fps|hz|khz)\\)?\\s*$", RegexOptions.Compiled | RegexOptions.IgnoreCase),
		new Regex("^\\s*(cpu|gpu)\\s*$", RegexOptions.Compiled | RegexOptions.IgnoreCase),
		new Regex("^\\s*%\\s*\\p{L}{1,6}\\s*$", RegexOptions.Compiled)
	};

	internal static bool ContainsKorean(string s)
	{
		foreach (char c in s)
		{
			if (c >= '가' && c <= '\ud7af')
			{
				return true;
			}
			if (c >= 'Ѐ' && c <= 'ӿ')
			{
				return true;
			}
			if (c >= '一' && c <= '\u9fff')
			{
				return true;
			}
			if (c >= '\u3040' && c <= 'ヿ')
			{
				return true;
			}
			if (c >= '\u0e00' && c <= '\u0e7f')
			{
				return true;
			}
			if (c >= '\u0600' && c <= 'ۿ')
			{
				return true;
			}
		}
		return false;
	}

	internal void ExportUntranslated()
	{
		string path = Path.Combine(Path.GetDirectoryName(translationFilePath), "untranslated.txt");
		List<string> list = new List<string>(untranslatedStrings);
		list.Sort();
		using (StreamWriter streamWriter = new StreamWriter(path, append: false, Encoding.UTF8))
		{
			streamWriter.WriteLine($"// Untranslated strings found in game ({list.Count} entries)");
			streamWriter.WriteLine("// Copy these to ko.json and add Korean translations");
			streamWriter.WriteLine();
			foreach (string item in list)
			{
				string text = item.Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("\n", "\\n");
				streamWriter.WriteLine("\"" + text + "\": \"\",");
			}
		}
		Log.LogInfo((object)$"Exported {list.Count} untranslated strings to untranslated.txt");
	}

	internal void ExtractGameData()
	{
		string directoryName = Path.GetDirectoryName(translationFilePath);
		StringBuilder stringBuilder = new StringBuilder();
		stringBuilder.AppendLine("// ========== EXTRACTED GAME DATA ==========");
		stringBuilder.AppendLine($"// Extraction time: {DateTime.Now}");
		stringBuilder.AppendLine();
		int num = 0;
		try
		{
			stringBuilder.AppendLine("// ========== DID YOU KNOW? HINTS ==========");
			MonoBehaviour[] array = Resources.FindObjectsOfTypeAll<MonoBehaviour>();
			foreach (MonoBehaviour val in array)
			{
				if (((object)val).GetType().Name != "HintsTipsDisplay")
				{
					continue;
				}
				FieldInfo field = ((object)val).GetType().GetField("hintsCSV", BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
				if (field != null)
				{
					object value = field.GetValue(val);
					TextAsset val2 = (TextAsset)((value is TextAsset) ? value : null);
					if ((Object)(object)val2 != (Object)null && !string.IsNullOrEmpty(val2.text))
					{
						stringBuilder.AppendLine($"// Raw CSV ({val2.text.Length} chars):");
						stringBuilder.AppendLine(val2.text);
						stringBuilder.AppendLine();
						stringBuilder.AppendLine("// --- Parsed Hints for ko.json ---");
						string[] array2 = val2.text.Split('\n');
						string[] array3 = array2;
						foreach (string text in array3)
						{
							if (string.IsNullOrWhiteSpace(text))
							{
								continue;
							}
							List<string> list = ParseCSVLine(text);
							if (list.Count >= 3)
							{
								string text2 = list[1].Trim();
								string text3 = list[2].Trim();
								if (!string.IsNullOrEmpty(text3) && text3.Length > 1)
								{
									string text4 = text3.Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("\n", "\\n");
									stringBuilder.AppendLine("// Type: " + text2);
									stringBuilder.AppendLine("\"" + text4 + "\": \"\",");
									num++;
								}
							}
							else if (list.Count >= 2)
							{
								string text5 = list[list.Count - 1].Trim();
								if (!string.IsNullOrEmpty(text5) && text5.Length > 1)
								{
									string text6 = text5.Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("\n", "\\n");
									stringBuilder.AppendLine("\"" + text6 + "\": \"\",");
									num++;
								}
							}
						}
						Log.LogInfo((object)$"Extracted {array2.Length} hint lines from CSV");
					}
					else
					{
						stringBuilder.AppendLine("// hintsCSV TextAsset is null or empty");
					}
				}
				else
				{
					stringBuilder.AppendLine("// hintsCSV field not found");
				}
				break;
			}
		}
		catch (Exception ex)
		{
			stringBuilder.AppendLine("// Error extracting hints: " + ex.Message);
			Log.LogWarning((object)("Hint extraction error: " + ex.Message));
		}
		stringBuilder.AppendLine();
		try
		{
			stringBuilder.AppendLine("// ========== ENCYCLOPEDIA DESCRIPTIONS ==========");
			ScriptableObject[] array4 = Resources.FindObjectsOfTypeAll<ScriptableObject>();
			foreach (ScriptableObject val3 in array4)
			{
				if (((object)val3).GetType().Name != "Encyclopedia")
				{
					continue;
				}
				string[] array3 = new string[7] { "aircraft", "vehicles", "ships", "buildings", "missiles", "scenery", "otherUnits" };
				foreach (string text7 in array3)
				{
					FieldInfo field2 = ((object)val3).GetType().GetField(text7, BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
					if (field2 == null || !(field2.GetValue(val3) is IList list2))
					{
						continue;
					}
					stringBuilder.AppendLine($"// --- {text7} ({list2.Count} entries) ---");
					foreach (object item in list2)
					{
						if (item == null)
						{
							continue;
						}
						FieldInfo field3 = item.GetType().GetField("name", BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
						FieldInfo field4 = item.GetType().GetField("description", BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
						string text8 = null;
						string text9 = null;
						if (field3 != null)
						{
							text8 = field3.GetValue(item) as string;
						}
						if (field4 != null)
						{
							text9 = field4.GetValue(item) as string;
						}
						if (text8 == null)
						{
							PropertyInfo property = item.GetType().GetProperty("name", BindingFlags.Instance | BindingFlags.Public);
							if (property != null)
							{
								text8 = property.GetValue(item) as string;
							}
						}
						if (text9 == null)
						{
							PropertyInfo property2 = item.GetType().GetProperty("description", BindingFlags.Instance | BindingFlags.Public);
							if (property2 != null)
							{
								text9 = property2.GetValue(item) as string;
							}
						}
						FieldInfo field5 = item.GetType().GetField("jsonKey", BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
						string text10 = null;
						if (field5 != null)
						{
							text10 = field5.GetValue(item) as string;
						}
						FieldInfo field6 = item.GetType().GetField("displayName", BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
						string text11 = null;
						if (field6 != null)
						{
							text11 = field6.GetValue(item) as string;
						}
						stringBuilder.AppendLine("// Unit: " + (text8 ?? "(null)") + " | JsonKey: " + (text10 ?? "(null)") + " | DisplayName: " + (text11 ?? "(null)"));
						if (!string.IsNullOrEmpty(text9))
						{
							string text12 = text9.Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("\n", "\\n")
								.Replace("\r", "");
							stringBuilder.AppendLine("\"" + text12 + "\": \"\",");
							num++;
						}
						else
						{
							stringBuilder.AppendLine("// (no description)");
						}
					}
				}
				break;
			}
		}
		catch (Exception ex2)
		{
			stringBuilder.AppendLine("// Error extracting encyclopedia: " + ex2.Message);
			Log.LogWarning((object)("Encyclopedia extraction error: " + ex2.Message));
		}
		try
		{
			stringBuilder.AppendLine();
			stringBuilder.AppendLine("// ========== UNIT DEFINITION STRUCTURE ==========");
			ScriptableObject[] array4 = Resources.FindObjectsOfTypeAll<ScriptableObject>();
			foreach (ScriptableObject val4 in array4)
			{
				string name = ((object)val4).GetType().Name;
				if (!name.Contains("Definition") || !(((object)val4).GetType().BaseType != null))
				{
					continue;
				}
				stringBuilder.AppendLine("// Type: " + name + " (Base: " + ((object)val4).GetType().BaseType.Name + ")");
				FieldInfo[] fields = ((object)val4).GetType().GetFields(BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
				foreach (FieldInfo fieldInfo in fields)
				{
					object obj = null;
					try
					{
						obj = fieldInfo.GetValue(val4);
					}
					catch
					{
					}
					string text13 = ((obj != null) ? obj.ToString() : "(null)");
					if (text13.Length > 200)
					{
						text13 = text13.Substring(0, 200) + "...";
					}
					stringBuilder.AppendLine("//   " + fieldInfo.FieldType.Name + " " + fieldInfo.Name + " = " + text13);
				}
				break;
			}
		}
		catch (Exception ex3)
		{
			stringBuilder.AppendLine("// Error: " + ex3.Message);
		}
		File.WriteAllText(Path.Combine(directoryName, "extracted_gamedata.txt"), stringBuilder.ToString(), Encoding.UTF8);
		Log.LogInfo((object)$"Game data extracted! {num} entries saved to extracted_gamedata.txt");
	}

	/// <summary>
	/// Выгружает все длинные текстовые строки из загруженных объектов (ScriptableObject/MonoBehaviour),
	/// включая определения оружия и техники из модов. Пишет extracted_strings.txt. Горячая клавиша: Ctrl+F6.
	/// </summary>
	internal void ExtractAllStrings()
	{
		string directoryName = Path.GetDirectoryName(translationFilePath);
		SortedDictionary<string, string> sortedDictionary = new SortedDictionary<string, string>();
		List<string> list = new List<string>();
		try
		{
			CollectLongStrings(Resources.FindObjectsOfTypeAll<ScriptableObject>(), sortedDictionary, list);
			CollectLongStrings(Resources.FindObjectsOfTypeAll<MonoBehaviour>(), sortedDictionary, list);
		}
		catch (Exception ex)
		{
			Log.LogWarning((object)("ExtractAllStrings failed: " + ex.Message));
		}
		StringBuilder stringBuilder = new StringBuilder();
		stringBuilder.AppendLine("// ========== ALL TEXT STRINGS FROM LOADED OBJECTS ==========");
		stringBuilder.AppendLine($"// Extracted: {DateTime.Now}");
		stringBuilder.AppendLine($"// Total: {sortedDictionary.Count} / untranslated: {CountUntranslated(sortedDictionary)}");
		stringBuilder.AppendLine();
		foreach (KeyValuePair<string, string> item in sortedDictionary)
		{
			if (Translations.ContainsKey(item.Key))
			{
				continue;
			}
			stringBuilder.AppendLine("// " + item.Value);
			stringBuilder.AppendLine("\"" + EscapeForJson(item.Key) + "\": \"\",");
		}
		stringBuilder.AppendLine();
		stringBuilder.AppendLine("// ========== RAW LONG STRINGS (JSON/asset blobs) ==========");
		foreach (string item2 in list)
		{
			stringBuilder.AppendLine("// ---");
			stringBuilder.AppendLine(item2);
		}
		File.WriteAllText(Path.Combine(directoryName, "extracted_strings.txt"), stringBuilder.ToString(), Encoding.UTF8);
		Log.LogInfo((object)$"ExtractAllStrings: {sortedDictionary.Count} text, {list.Count} raw -> extracted_strings.txt");
	}

	/// <summary>Сколько найденных строк ещё не переведено.</summary>
	private static int CountUntranslated(IDictionary<string, string> found)
	{
		int num = 0;
		foreach (KeyValuePair<string, string> item in found)
		{
			if (!Translations.ContainsKey(item.Key))
			{
				num++;
			}
		}
		return num;
	}

	/// <summary>Экранирует строку для записи в JSON-подобный файл.</summary>
	private static string EscapeForJson(string s)
	{
		return s.Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("\r", "").Replace("\n", "\\n");
	}

	/// <summary>Обходит массив объектов и собирает строки.</summary>
	private static void CollectLongStrings(Array objects, IDictionary<string, string> found, List<string> rawLong)
	{
		if (objects == null)
		{
			return;
		}
		foreach (object obj in objects)
		{
			if (obj != null)
			{
				CollectFromObject(obj, found, rawLong, 0);
			}
			if (found.Count > 30000 || rawLong.Count > 400)
			{
				break;
			}
		}
	}

	/// <summary>Рекурсивно читает строковые поля объекта (и вложенных списков).</summary>
	private static void CollectFromObject(object obj, IDictionary<string, string> found, List<string> rawLong, int depth)
	{
		if (obj == null || depth > 3)
		{
			return;
		}
		if (obj is IList list)
		{
			int num = 0;
			foreach (object item in list)
			{
				if (++num > 5000)
				{
					break;
				}
				CollectFromObject(item, found, rawLong, depth + 1);
			}
			return;
		}
		string name = obj.GetType().Name;
		Type type = obj.GetType();
		while (type != null && type != typeof(object))
		{
			FieldInfo[] fields;
			try
			{
				fields = type.GetFields(BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
			}
			catch
			{
				return;
			}
			foreach (FieldInfo fieldInfo in fields)
			{
				object obj2;
				try
				{
					obj2 = fieldInfo.GetValue(obj);
				}
				catch
				{
					continue;
				}
				if (obj2 is string s)
				{
					AddFoundString(s, name + "." + fieldInfo.Name, found, rawLong);
				}
				else if (obj2 != null && depth < 2 && !(obj2 is UnityEngine.Object) && !obj2.GetType().IsPrimitive && !obj2.GetType().IsEnum)
				{
					// заходим и в обычные (не списочные) объекты — описания бывают вложенными
					CollectFromObject(obj2, found, rawLong, depth + 1);
				}
			}
			type = type.BaseType;
		}
	}

	/// <summary>Добавляет строку в набор: как текст-предложение или как «сырой» блоб.</summary>
	private static void AddFoundString(string s, string source, IDictionary<string, string> found, List<string> rawLong)
	{
		if (string.IsNullOrEmpty(s) || s.Length < 25)
		{
			return;
		}
		if (LooksLikeSentence(s))
		{
			if (!found.ContainsKey(s))
			{
				found[s] = source;
			}
			return;
		}
		if (s.Length >= 80 && rawLong.Count < 400 && !rawLong.Contains(s))
		{
			rawLong.Add(s);
		}
	}

	/// <summary>Похожа ли строка на человеческое предложение (а не на код/JSON).</summary>
	private static bool LooksLikeSentence(string s)
	{
		if (s.Length < 25 || s.Length > 600)
		{
			return false;
		}
		int num = 0;
		int num2 = 0;
		int num3 = 0;
		foreach (char c in s)
		{
			if (char.IsLetter(c))
			{
				num++;
				if (char.IsLower(c))
				{
					num2++;
				}
			}
			else if (c == ' ')
			{
				num3++;
			}
		}
		return num3 >= 3 && num2 >= 12 && num * 100 / s.Length >= 60;
	}

	private static List<string> ParseCSVLine(string line)
	{
		List<string> list = new List<string>();
		bool flag = false;
		StringBuilder stringBuilder = new StringBuilder();
		foreach (char c in line)
		{
			switch (c)
			{
			case '"':
				flag = !flag;
				continue;
			case ',':
				if (!flag)
				{
					list.Add(stringBuilder.ToString());
					stringBuilder.Clear();
					continue;
				}
				break;
			}
			stringBuilder.Append(c);
		}
		list.Add(stringBuilder.ToString());
		return list;
	}

	private static bool IsDialogueBoxTitle(TMP_Text instance)
	{
		if ((Object)(object)instance == (Object)null)
		{
			return false;
		}
		DialogueBox componentInParent = ((Component)instance).GetComponentInParent<DialogueBox>();
		if ((Object)(object)componentInParent == (Object)null)
		{
			return false;
		}
		if (!_fDialogTitleTextCached)
		{
			_fDialogTitleTextCached = true;
			_fDialogTitleText = typeof(DialogueBox).GetField("titleText", BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
		}
		if (_fDialogTitleText == null)
		{
			return false;
		}
		object value = _fDialogTitleText.GetValue(componentInParent);
		TMP_Text val = (TMP_Text)((value is TMP_Text) ? value : null);
		return (Object)(object)instance == (Object)(object)val;
	}

